# ./start.sh (or bash scripts/configure.sh) generates .env with unique local database/session secrets.
# Database: postgres (default) or mysql, chosen on the first run (LOOPFORGE_DATABASE=mysql ./start.sh).
# A .env without this line is a MySQL installation from before PostgreSQL was the default; configure.sh adds
# LOOPFORGE_DATABASE=mysql to it. Changing it later starts the other database empty; there is no data migration.
LOOPFORGE_DATABASE=postgres
# Keeps plain `docker compose up/ps/down` including the database service; configure.sh keeps it in sync.
COMPOSE_PROFILES=postgres
# Platform image: empty uses the GHCR release pinned in compose.yaml. Prefer an @sha256: digest when overriding.
# Slow ghcr.io links: MIRROR=ghcr.nju.edu.cn ./start.sh replaces the ghcr.io host and tags the image back. See README.zh-CN.md.
LOOPFORGE_IMAGE=
# Source build of this checkout (./start.sh dev writes this line; ./start.sh release removes it):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
AGENTFLOW_HTTP_PORT=8090
# DSN of the platform container on the Compose network (MySQL: loopforge:REPLACE_ME@tcp(mysql:3306)/loopforge).
LOOPFORGE_COMPOSE_DSN=postgres://loopforge:REPLACE_ME@postgres:5432/loopforge?sslmode=disable
# DSN for host processes (scripts/dev.sh, loopforge-account); AGENTFLOW_MYSQL_DSN is a legacy alias.
# MySQL: loopforge:REPLACE_ME@tcp(127.0.0.1:33315)/loopforge
AGENTFLOW_DATABASE_DSN=postgres://loopforge:REPLACE_ME@127.0.0.1:35432/loopforge?sslmode=disable
AGENTFLOW_SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AGENTFLOW_AUTH_REQUIRED=true
LOOPFORGE_DB_PASSWORD=REPLACE_ME
LOOPFORGE_DB_ROOT_PASSWORD=REPLACE_ME
LOOPFORGE_POSTGRES_PORT=35432
LOOPFORGE_MYSQL_PORT=33315
# Optional public address reachable from execution containers/runners:
AGENTFLOW_PLATFORM_MCP_URL=
# Optional model IDs available to your CodeBuddy account (comma-separated):
AGENTFLOW_ASSISTANT_MODELS=
AGENTFLOW_ASSISTANT_MODEL=
# Optional default CLI for new conversations (codebuddy when unset). See docs/deployment.md.
# AGENTFLOW_DEFAULT_EXECUTOR=kiro
# Optional path to administrator-verified SSH host keys. See docs/deployment.md.
AGENTFLOW_GIT_SSH_KNOWN_HOSTS=
# Worker separation, installed runners and preview settings retain AGENTFLOW_ names.
# See docs/deployment.md. Production HTTPS: AGENTFLOW_SECURE_COOKIES=true.
